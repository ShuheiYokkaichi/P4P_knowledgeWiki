% Glossary commands
\newcommand{\glossarytablerows}{} % Initialise rows
\newcommand{\ESBaddterminology}[2]{
    % Append rows to \glossarytablerows
    \gappto{\glossarytablerows}{#1 & #2 \tabularnewline}%
}
\newcommand{\ESBprintglossary}{
    % Print the glossary
    \begin{longtable}[c]{>{\raggedright}p{0.2\linewidth}>{\raggedright}p{0.7\linewidth}}
        \glossarytablerows % Add collected rows here
    \end{longtable}
}

% Glossary commands
\newcommand{\abbreviationtablerows}{} % Initialize empty
\newcommand{\ESBaddabbreviation}[2]{
    % Append rows to \abbreviationtablerows
    \gappto{\abbreviationtablerows}{#1 & #2 \tabularnewline}%
}
\newcommand{\ESBprintabbreviations}{
    % Print the abbreviations
    \begin{longtable}[c]{>{\raggedright}p{0.2\linewidth}>{\raggedright}p{0.7\linewidth}}
        \abbreviationtablerows % Add collected rows here
    \end{longtable}
}


\newcommand{\ESBappendix}{
    \appendix % Start and format the appendix
    \addappheadtotoc % Add Appendices to table of contents

    % Reset Numberings for things
    \counterwithin{figure}{section} 
    \counterwithin{table}{section}
    \counterwithin{lstlisting}{section}
    \counterwithin{equation}{section}
}


\newcommand{\ESBfrontsection}[1]{\section*{\centering  #1}\addcontentsline{toc}{section}{#1}} % Formatted front matter sections.

