+def _snapshot_errors(snapshot: dict[str, Any]) -> dict[str, str]:
+    """Return collection failures and per-path read or size-limit errors.
+
+    Parameters
+    ----------
+    snapshot : dict[str, Any]
+        Global settings and named-object inventories captured for one file.
+
+    Returns
+    -------
+    dict[str, str]
+        Unavailable snapshot sections or paths and their error messages.
+    """
+    errors: dict[str, str] = {}
+    for section, values in snapshot.items():
+        if "_error" in values:
+            errors[section] = values["_error"]
+            continue
+        for path, value in values.items():
+            if isinstance(value, dict) and set(value) == {"error"}:
+                errors[f"{section}.{path}"] = value["error"]
+            elif value == "<large_state_omitted>":
+                errors[f"{section}.{path}"] = "state exceeded capture size limit"
+    return errors
+
