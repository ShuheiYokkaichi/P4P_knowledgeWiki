+"""Read monitor samples from the connected solver."""
+
+from __future__ import annotations
+
+from typing import Any
+
+from ansys.fluent.mcp.common.backend import Backend
+
+
+async def read_monitor_history_impl(
+    backend: Backend,
+    *,
+    monitor_set: str | None = None,
+    max_points: int = 100,
+) -> dict[str, Any]:
+    """List monitor sets or read the latest captured samples from a named set."""
+    return await backend.read_monitor_history(monitor_set=monitor_set, max_points=max_points)
