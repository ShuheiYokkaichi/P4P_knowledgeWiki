--- /dev/null
+++ b/tests/test_monitor_history.py
@@ -0,0 +1,113 @@
+# Copyright (C) 2026 Synopsys, Inc. and ANSYS, Inc. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
