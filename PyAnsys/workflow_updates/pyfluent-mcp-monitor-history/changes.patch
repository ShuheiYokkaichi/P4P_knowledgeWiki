+# limitations under the License.
+
+
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import numpy as np
+import pytest
+
+from ansys.fluent.mcp.common.errors import BackendUnavailableError, InvalidArgumentsError
+from ansys.fluent.mcp.solve import SolveMCP
+from ansys.fluent.mcp.solve.backends.composite import SolveCompositeBackend
+from ansys.fluent.mcp.solve.backends.pyfluent import PyFluentBackend
+
+
+@pytest.fixture
+def live_backend():
+    monitors = Mock()
+    monitors.get_monitor_set_names.return_value = ["residual", "outlet-flow"]
+    monitors.get_monitor_set_prop.return_value = "iteration"
+    session = SimpleNamespace(is_active=lambda: True, monitors=monitors)
+    backend = PyFluentBackend()
+    backend.adopt_session(session, endpoint="test-session")
+    return backend, monitors
+
+
+@pytest.mark.asyncio
+async def test_monitor_history_mcp_returns_bounded_json_samples(live_backend):
+    backend, monitors = live_backend
+    monitors.get_monitor_set_data.return_value = (
+        np.array([4, 5]),
+        {"continuity": np.array([0.002, np.nan]), "x-velocity": np.array([np.inf, 0.001])},
+    )
+    composite = SolveCompositeBackend(pyfluent_backend=backend)
+    server = SolveMCP(backends={"pyfluent": composite})
+
+    result = await server.call_tool(
+        "read_monitor_history", {"monitor_set": "residual", "max_points": 2}
+    )
+
+    payload = result.structured_content
+    assert payload.get("result", payload) == {
+        "source": "session.monitors",
+        "available_monitor_sets": ["outlet-flow", "residual"],
+        "monitor_set": "residual",
+        "status": "ok",
+        "x_label": "iteration",
+        "x_values": [4, 5],
+        "series": {"continuity": [0.002, None], "x-velocity": [None, 0.001]},
+        "point_count": 2,
+    }
+    monitors.get_monitor_set_data.assert_called_once_with(
+        monitor_set_name="residual", start_index=-2
+    )
+    monitors.start.assert_not_called()
+    monitors.stop.assert_not_called()
+
+
+@pytest.mark.asyncio
+async def test_monitor_history_lists_and_reports_empty_or_unavailable_sets(live_backend):
+    backend, monitors = live_backend
+    monitors.get_monitor_set_data.return_value = (np.array([]), {})
+
+    discovery = await backend.read_monitor_history(monitor_set=None, max_points=100)
+    assert discovery["available_monitor_sets"] == ["outlet-flow", "residual"]
+    unavailable = await backend.read_monitor_history(monitor_set="unknown", max_points=100)
+    assert unavailable["status"] == "monitor_set_unavailable"
+    monitors.get_monitor_set_data.assert_not_called()
+
+    empty = await backend.read_monitor_history(monitor_set="outlet-flow", max_points=100)
+    assert empty["status"] == "no_samples"
+    assert empty["x_values"] == [] and empty["series"] == {} and empty["point_count"] == 0
+
+
+@pytest.mark.asyncio
+async def test_monitor_history_handles_set_disappearing_during_monitor_refresh(live_backend):
+    backend, monitors = live_backend
+    monitors.get_monitor_set_names.side_effect = [["residual"], []]
+    monitors.get_monitor_set_data.side_effect = KeyError("residual")
+
+    result = await backend.read_monitor_history(monitor_set="residual", max_points=100)
+    assert result["status"] == "monitor_set_unavailable"
+    assert result["available_monitor_sets"] == []
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(("monitor_set", "max_points"), [("", 100), ("residual", 0), (None, 1001)])
+async def test_monitor_history_rejects_invalid_arguments(monitor_set, max_points):
+    with pytest.raises(InvalidArgumentsError):
+        await PyFluentBackend().read_monitor_history(monitor_set=monitor_set, max_points=max_points)
+
+
+@pytest.mark.asyncio
+async def test_monitor_history_reports_missing_monitor_manager():
+    backend = PyFluentBackend()
+    backend.adopt_session(SimpleNamespace(is_active=lambda: True), endpoint="test-session")
+
+    with pytest.raises(BackendUnavailableError, match="no monitor manager"):
+        await backend.read_monitor_history(monitor_set=None, max_points=100)
