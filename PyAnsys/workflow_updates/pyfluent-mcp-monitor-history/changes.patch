@@ -2632,6 +2633,72 @@ class PyFluentBackend(Backend):
 
         return await self._read_locked(_do)
 
+    async def read_monitor_history(
+        self, *, monitor_set: str | None, max_points: int
+    ) -> dict[str, Any]:
+        """Return recent samples captured by the current session's monitor stream."""
+        if not 1 <= max_points <= 1000:
+            raise InvalidArgumentsError("max_points must be between 1 and 1000.")
+        if monitor_set is not None and not monitor_set.strip():
+            raise InvalidArgumentsError("monitor_set must be a non-empty name.")
+
+        def _do() -> dict[str, Any]:
+            monitors = getattr(self._require(), "monitors", None)
+            if monitors is None:
+                raise BackendUnavailableError("This PyFluent session has no monitor manager.")
+
+            names = sorted(monitors.get_monitor_set_names())
+            result: dict[str, Any] = {
+                "source": "session.monitors",
+                "available_monitor_sets": names,
+            }
+            if monitor_set is None:
+                return result
+
+            result.update(
+                monitor_set=monitor_set,
+                status="monitor_set_unavailable",
+                x_label=None,
+                x_values=[],
+                series={},
+                point_count=0,
+            )
+            if monitor_set not in names:
+                return result
+
+            x_label = monitors.get_monitor_set_prop(monitor_set, "xlabel")
+            try:
+                # Slice in PyFluent so only the requested tail is converted to arrays.
+                x_values, series = monitors.get_monitor_set_data(
+                    monitor_set_name=monitor_set, start_index=-max_points
+                )
+            except KeyError:
+                # A data-load or initialization event can refresh the monitor sets.
+                result["available_monitor_sets"] = sorted(monitors.get_monitor_set_names())
+                return result
+
+            # PyFluent can refresh the set between these individually locked reads.
+            if monitors.get_monitor_set_prop(monitor_set, "xlabel") != x_label:
+                result.update(
+                    status="monitor_set_refreshed",
+                    available_monitor_sets=sorted(monitors.get_monitor_set_names()),
+                )
+                return result
+
+            result.update(
+                status="ok" if len(x_values) else "no_samples",
+                x_label=x_label,
+                x_values=[value if math.isfinite(value) else None for value in x_values.tolist()],
+                series={
+                    name: [value if math.isfinite(value) else None for value in values.tolist()]
+                    for name, values in series.items()
+                },
+                point_count=len(x_values),
+            )
+            return result
+
+        return await self._read_locked(_do)
+
     async def get_targeted_context(
         self,
         *,
